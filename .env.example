# ==============================================================================
# Minty-Asset Money Manager — Example Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your real keys.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Developer & GitHub Personal Access Tokens
GITHUB_PERSONAL_ACCESS_TOKEN=
GH_TOKEN=

# Google Account Integration (Zero-Cost Sync & Versioned Drive Backups)
# Scopes: drive.appdata, drive.file
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_API_KEY=

# Application Core & Runtime Configuration
NODE_ENV=development
PORT=3000
APP_NAME="Minty Asset - Money Manager"
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session Secrets
JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=

# Database & Cache
DATABASE_URL=postgresql://user:password@localhost:5432/minty_asset_db?sslmode=prefer
REDIS_URL=redis://localhost:6379/0

# Financial Aggregator (Plaid)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions,auth,balance
PLAID_COUNTRY_CODES=US,CA,GB,EU

# Market Data & Forex
EXCHANGE_RATE_API_KEY=
FINNHUB_API_KEY=

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI Financial Insights
GEMINI_API_KEY=
OPENAI_API_KEY=

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
